{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "SuperSecretKeyAtLeast32CharactersLongForDevEnvironment",
    "Issuer": "YourSystem",
    "Audience": "YourClients"
  },
  "SwaggerServices": {
    "Identity": "/identity/swagger/v1/swagger.json"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" },
          { "X-Forwarded": "Set" },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/identity"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5173/"
          }
        }
      }
    }
  }
}
